# ============================================================
# TrainETA Backend — Environment Variables
# Copy this file to .env (or set in your deployment platform)
# ============================================================

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Do NOT use * in production — must include your Hostinger domain.
# Example: https://traineta.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Model Artifacts ───────────────────────────────────────
# Absolute or relative path to the trained Model A artifact.
# The file is produced by backend/train_model.py.
MODEL_A_PATH=backend/models/model_a.json

# Phase 2 only — not required in Phase 1:
# MODEL_B_PATH=backend/models/model_b.json

# ── Live Scraper Data ─────────────────────────────────────
# Path to the reconciled_positions.parquet file produced by
# the REMOTE scraper machine and dropped here (via shared
# drive, rsync, or any file-sync mechanism).
#
# Leave blank to run in "static-only" mode (Model A uses
# historical baseline features, no live delay enrichment).
# This is the expected state for Phase 1 until the scraper
# is deployed and connected.
#
# When set, the backend reads and caches this file every 60s.
# If the file is older than 2 hours, /health adds:
#   "data_freshness_warning": true
#
# Expected schema of the parquet file:
#   train_no              int    (IR train number)
#   station_no            int    (stop sequence on the route)
#   station_name          str    (station code, e.g. "NDLS")
#   delay                 float  (current delay in minutes; negative = early)
#   date                  datetime (journey date UTC)
#   scraped_at            datetime (when this row was written UTC)
#   source_agreement_score float  (0-1, multi-source confidence)
#
RECONCILED_DATA_PATH=

# ── Prediction Behaviour ──────────────────────────────────
# If data_confidence_score < threshold, fall back to baseline-only.
# Default: 0.3  (set in errors.py; override here if needed)
DATA_CONFIDENCE_THRESHOLD=0.3
